# Local, machine-specific config. Tracked template lives in env.example.
.env
__pycache__/
*.pyc

# Local testing artifacts generated by native runner smoke tests.
/.testing/

# .fkst/ is the runtime interface dir, mixed tracked + ignored. This repo is
# Lua-primary (committed packages live at the repo root under packages/), so the
# whole of .fkst/ is runtime except the tracked conformance config:
/.fkst/packages
/.fkst/local-packages
/.fkst/run/
/.fkst/env
