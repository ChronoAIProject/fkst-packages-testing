{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronoaiproject.github.io/fkst-packages-testing/schemas/testing-schema-fixtures.v1.schema.json",
  "title": "Testing Schema Fixtures v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "fixture_sets"],
  "properties": {
    "schema": {"const": "testing-schema-fixtures.v1"},
    "fixture_sets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/fixtureSet"}
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._/-]+$"
    },
    "fixtureSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_path", "fixture_root", "index_path", "classification_path"],
      "properties": {
        "schema_id": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^https://"},
        "schema_path": {"$ref": "#/$defs/path"},
        "fixture_root": {"$ref": "#/$defs/path"},
        "index_path": {"$ref": "#/$defs/path"},
        "classification_path": {
          "anyOf": [
            {"$ref": "#/$defs/path"},
            {"type": "null"}
          ]
        }
      }
    }
  }
}
