{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronoaiproject.github.io/fkst-packages-testing/schemas/testing-package-manifest.v1.schema.json",
  "title": "Testing Package Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "canonicalization",
    "package_id",
    "package_version",
    "source_commit",
    "package_content_sha256",
    "supported_contracts",
    "entrypoints",
    "semantic_capabilities",
    "runtime_requirements",
    "dependencies",
    "producer",
    "creation_metadata",
    "manifest_digest"
  ],
  "properties": {
    "schema": {
      "const": "testing-package-manifest.v1"
    },
    "canonicalization": {
      "const": "fkst-testing-package-manifest-canonical-json.v1"
    },
    "package_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "allOf": [
        {
          "not": {
            "pattern": "[\\u0000-\\u001F]"
          }
        },
        {
          "not": {
            "pattern": "/"
          }
        },
        {
          "not": {
            "pattern": "\\\\"
          }
        },
        {
          "not": {
            "pattern": "\\.\\."
          }
        }
      ]
    },
    "package_version": {
      "$ref": "#/$defs/exactSemver"
    },
    "source_commit": {
      "$ref": "#/$defs/exactCommit"
    },
    "package_content_sha256": {
      "$ref": "#/$defs/exactSha256"
    },
    "supported_contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "majors",
        "canonicalization_profiles"
      ],
      "properties": {
        "majors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "const": "testing-runner.v1"
          }
        },
        "canonicalization_profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "const": "fkst-testing-package-manifest-canonical-json.v1"
          }
        }
      }
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "contract_major",
          "capabilities"
        ],
        "properties": {
          "name": {
            "enum": [
              "testing-runner.run",
              "testing-runner.supervise"
            ]
          },
          "contract_major": {
            "const": "testing-runner.v1"
          },
          "capabilities": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/boundedString"
            }
          }
        }
      }
    },
    "semantic_capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/boundedString"
      }
    },
    "runtime_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lua",
        "platforms"
      ],
      "properties": {
        "lua": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "allOf": [
            {
              "not": {
                "pattern": "[\\u0000-\\u001F]"
              }
            },
            {
              "not": {
                "pattern": "[*~<>=|]"
              }
            }
          ]
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/boundedString"
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fkst_packages",
        "fkst_substrate"
      ],
      "properties": {
        "fkst_packages": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "commit"
          ],
          "properties": {
            "id": {
              "const": "fkst-packages"
            },
            "commit": {
              "$ref": "#/$defs/exactCommit"
            }
          }
        },
        "fkst_substrate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "commit"
          ],
          "properties": {
            "id": {
              "const": "fkst-substrate"
            },
            "commit": {
              "$ref": "#/$defs/exactCommit"
            }
          }
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "toolchain"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/boundedString"
        },
        "version": {
          "$ref": "#/$defs/exactSemver"
        },
        "toolchain": {
          "$ref": "#/$defs/boundedString"
        }
      }
    },
    "creation_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "build_id"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "minLength": 20,
          "maxLength": 64,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "build_id": {
          "$ref": "#/$defs/boundedString"
        }
      }
    },
    "manifest_digest": {
      "$ref": "#/$defs/exactSha256"
    }
  },
  "$defs": {
    "boundedString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "not": {
        "pattern": "[\\u0000-\\u001F]"
      }
    },
    "exactCommit": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "exactSemver": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "exactSha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
