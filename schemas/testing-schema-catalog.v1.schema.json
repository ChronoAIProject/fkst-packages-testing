{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronoaiproject.github.io/fkst-packages-testing/schemas/testing-schema-catalog.v1.schema.json",
  "title": "Testing Schema Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "canonicalization", "schemas", "catalog_sha256"],
  "properties": {
    "schema": {"const": "testing-schema-catalog.v1"},
    "canonicalization": {"const": "fkst-testing-schema-catalog-canonical-json.v1"},
    "schemas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/entry"}
    },
    "catalog_sha256": {"$ref": "testing-package-manifest.v1.schema.json#/$defs/exactSha256"}
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "path", "draft", "canonicalization_profile", "schema_sha256", "contract_major", "status", "fixture_set_path", "fixture_set_sha256"],
      "properties": {
        "schema_id": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^https://"},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^schemas/[A-Za-z0-9._-]+\\.schema\\.json$"},
        "draft": {"const": "https://json-schema.org/draft/2020-12/schema"},
        "canonicalization_profile": {"type": ["string", "null"], "maxLength": 180},
        "schema_sha256": {"$ref": "testing-package-manifest.v1.schema.json#/$defs/exactSha256"},
        "contract_major": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "status": {"const": "stable"},
        "fixture_set_path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^schema-release/fixture-sets/[A-Za-z0-9._-]+\\.json$"},
        "fixture_set_sha256": {"$ref": "testing-package-manifest.v1.schema.json#/$defs/exactSha256"}
      }
    }
  }
}
