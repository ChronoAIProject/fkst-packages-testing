{
  "schema": "testing-project-profile.v1",
  "revision": "controlled-fixture-1",
  "repository": {
    "url": "https://example.invalid/testing/controlled-fixture.git",
    "commit_sha": "1111111111111111111111111111111111111111"
  },
  "working_directory": ".",
  "commands": {
    "install": ["fixture-package-manager", "install", "--frozen"],
    "build": ["fixture-package-manager", "run", "build"],
    "start": ["fixture-runtime", "server.js"],
    "cleanup": ["scripts/cleanup-controlled-fixture"]
  },
  "application_listener_mode": "fkst-inherited-listeners-v1",
  "dependent_services": [
    {
      "name": "fixture-cache",
      "listener_mode": "fkst-inherited-listeners-v1",
      "start_argv": ["fixture-cache", "start", "--port", "6380"],
      "cleanup_argv": ["fixture-cache", "stop", "--port", "6380"],
      "readiness_checks": [
        {"type": "tcp", "host": "127.0.0.1", "port": 6380}
      ]
    }
  ],
  "readiness_checks": [
    {"type": "http", "url": "http://127.0.0.1:4173/health", "expected_status": 200}
  ],
  "allowed_origins": ["http://127.0.0.1:4173"],
  "secret_refs": [
    {
      "name": "FIXTURE_DATABASE_URL",
      "type": "secret-reference",
      "source_ref": {"kind": "host-secret", "ref": "fixtures/controlled/database-url"}
    }
  ],
  "mutation_policy": {"mode": "read-only"},
  "timeouts": {
    "install_seconds": 30,
    "build_seconds": 30,
    "migrate_seconds": 30,
    "seed_seconds": 30,
    "start_seconds": 30,
    "readiness_seconds": 30,
    "cleanup_seconds": 30,
    "total_seconds": 180,
    "receipt_ttl_seconds": 120
  },
  "resource_budgets": {
    "cpu_millis": 1000,
    "memory_mb": 1024,
    "disk_mb": 2048,
    "processes": 16,
    "network_requests": 200,
    "output_bytes": 1048576
  }
}
