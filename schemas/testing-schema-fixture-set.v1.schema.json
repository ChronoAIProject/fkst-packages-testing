{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronoaiproject.github.io/fkst-packages-testing/schemas/testing-schema-fixture-set.v1.schema.json",
  "title": "Testing Schema Fixture Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_id", "files", "fixture_set_sha256"],
  "properties": {
    "schema": {"const": "testing-schema-fixture-set.v1"},
    "schema_id": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^https://"},
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/file"}
    },
    "fixture_set_sha256": {"$ref": "testing-package-manifest.v1.schema.json#/$defs/exactSha256"}
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._/-]+$"},
        "sha256": {"$ref": "testing-package-manifest.v1.schema.json#/$defs/exactSha256"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    }
  }
}
