{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronoaiproject.github.io/fkst-packages-testing/schemas/testing-case-result-set.v2.schema.json",
  "title": "Testing Case Result Set v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "set_id", "run_id", "plan_ref", "plan_sha256", "cases",
    "evidence_manifest_ref", "evidence_manifest_sha256", "trace_id", "dedup_key"
  ],
  "properties": {
    "schema": {"const": "testing-case-result-set.v2"},
    "set_id": {"$ref": "#/$defs/boundedString180"},
    "run_id": {"$ref": "#/$defs/boundedString180"},
    "plan_ref": {"$ref": "#/$defs/reference"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "cases": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {"$ref": "testing-case-result.v2.schema.json"}
    },
    "evidence_manifest_ref": {
      "anyOf": [
        {"$ref": "testing-evidence-manifest.v1.schema.json#/$defs/reference"},
        {"$ref": "#/$defs/reference"}
      ]
    },
    "evidence_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_manifest_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "trace_id": {"$ref": "#/$defs/boundedString180"},
    "dedup_key": {"$ref": "#/$defs/boundedString180"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_manifest_ref": {
            "required": ["sha256"]
          }
        },
        "required": ["evidence_manifest_ref"]
      },
      "then": {"required": ["evidence_manifest_artifact_sha256"]}
    }
  ],
  "$defs": {
    "boundedString180": {
      "type": "string", "minLength": 1, "maxLength": 180, "x-fkst-maxUtf8Bytes": 180,
      "not": {"pattern": "[\\u0000-\\u001F]"}
    },
    "boundedString96": {
      "type": "string", "minLength": 1, "maxLength": 96, "x-fkst-maxUtf8Bytes": 96,
      "not": {"pattern": "[\\u0000-\\u001F]"}
    },
    "boundedString4096": {
      "type": "string", "minLength": 1, "maxLength": 4096, "x-fkst-maxUtf8Bytes": 4096,
      "not": {"pattern": "[\\u0000-\\u001F]"}
    },
    "sha256": {
      "type": "string", "minLength": 64, "maxLength": 64, "x-fkst-maxUtf8Bytes": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["kind", "ref"],
      "properties": {
        "kind": {"$ref": "#/$defs/boundedString96"},
        "ref": {"$ref": "#/$defs/boundedString4096"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
