{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronoaiproject.github.io/fkst-packages-testing/schemas/testing-assertion-result.v1.schema.json",
  "title": "Testing Assertion Result v1",
  "x-fkst-canonicalization": "fkst-testing-results-canonical-json.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "assertion_id", "type", "required", "status", "classification", "observation_ids", "evidence_refs"],
  "properties": {
    "schema": {"const": "testing-assertion-result.v1"},
    "assertion_id": {"$ref": "#/$defs/boundedString180"},
    "type": {"$ref": "#/$defs/boundedString96"},
    "required": {"type": "boolean"},
    "status": {"enum": ["passed", "failed", "skipped"]},
    "classification": {"enum": ["deterministic", "assertion_failure", "not_applicable", "skipped", "execution_error", "blocked", "lost"]},
    "observation_ids": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": {"$ref": "#/$defs/boundedString180"}
    },
    "evidence_refs": {
      "type": "array", "maxItems": 64,
      "items": {"$ref": "#/$defs/reference"}
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "passed"}}, "required": ["status"]}, "then": {"properties": {"classification": {"const": "deterministic"}}}},
    {"if": {"properties": {"status": {"const": "failed"}}, "required": ["status"]}, "then": {"properties": {"classification": {"const": "assertion_failure"}}}},
    {"if": {"properties": {"status": {"const": "skipped"}}, "required": ["status"]}, "then": {"properties": {"classification": {"enum": ["skipped", "not_applicable"]}}}}
  ],
  "$defs": {
    "boundedString96": {
      "type": "string", "minLength": 1, "maxLength": 96, "x-fkst-maxUtf8Bytes": 96, "format": "fkst-utf8-max-96",
      "not": {"pattern": "[\\u0000-\\u001F]"}
    },
    "boundedString180": {
      "type": "string", "minLength": 1, "maxLength": 180, "x-fkst-maxUtf8Bytes": 180, "format": "fkst-utf8-max-180",
      "not": {"pattern": "[\\u0000-\\u001F]"}
    },
    "boundedString4096": {
      "type": "string", "minLength": 1, "maxLength": 4096, "x-fkst-maxUtf8Bytes": 4096, "format": "fkst-utf8-max-4096",
      "not": {"pattern": "[\\u0000-\\u001F]"}
    },
    "sha256": {
      "type": "string", "minLength": 64, "maxLength": 64, "x-fkst-maxUtf8Bytes": 64, "format": "fkst-utf8-max-64",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["kind", "ref"],
      "properties": {
        "kind": {"$ref": "#/$defs/boundedString96"},
        "ref": {"$ref": "#/$defs/boundedString4096"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
