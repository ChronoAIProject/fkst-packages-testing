{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronoaiproject.github.io/fkst-packages-testing/schemas/testing-design.generation-receipt.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "outcome",
    "attempt",
    "request_digest",
    "input_digest",
    "raw_response_digest",
    "validated_output_digest",
    "candidate_set",
    "provider",
    "prompt_template",
    "policy_id",
    "budget",
    "rejected_candidates",
    "timing"
  ],
  "properties": {
    "schema": {
      "const": "testing-design.generation-receipt.v1"
    },
    "outcome": {
      "const": "complete"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "raw_response_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "validated_output_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "artifact_schema",
        "artifact_pointer",
        "artifact_digest"
      ],
      "properties": {
        "schema": {
          "const": "testing-design.artifact-reference.v1"
        },
        "artifact_schema": {
          "const": "testing-design.candidate-test-case-set.v1"
        },
        "artifact_pointer": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\?#@])[^\\u0000-\\u001F\\u007F]+$",
          "x-fkst-maxUtf8Bytes": 512
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "adapter_version",
        "model_id"
      ],
      "properties": {
        "adapter_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$",
          "x-fkst-maxUtf8Bytes": 180
        },
        "adapter_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$",
          "x-fkst-maxUtf8Bytes": 180
        }
      }
    },
    "prompt_template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_id",
        "template_version",
        "template_digest"
      ],
      "properties": {
        "template_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$",
          "x-fkst-maxUtf8Bytes": 180
        },
        "template_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "template_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "policy_id": {
      "const": "testing-design.generation-policy.v1"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_bytes",
        "response_bytes",
        "elapsed_ms"
      ],
      "properties": {
        "prompt_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "response_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "rejected_candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "reasons"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "reasons": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "count"
            ],
            "properties": {
              "code": {
                "enum": [
                  "duplicate-candidate",
                  "unsupported-action",
                  "unsupported-assertion",
                  "invalid-traceability",
                  "oversized-value",
                  "malformed-candidate"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              }
            }
          },
          "maxItems": 64
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "finished_at",
        "duration_ms"
      ],
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
