{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronoaiproject.github.io/fkst-packages-testing/schemas/testing-runner-invocation.v1.schema.json",
  "title": "Testing Runner Invocation v1",
  "description": "Portable validation of a canonical testing-runner invocation. Runtime resolution and effects are outside this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "canonicalization", "invocation_id", "qa_run_ref", "attempt_ref", "executor", "resolved_executor", "execution_profile", "approved_input_refs", "requested_capabilities", "budgets", "deadline_epoch_seconds", "producer", "trace_id", "dedup_key", "canonical_request_sha256"],
  "properties": {
    "schema": { "const": "testing-runner-invocation.v1" },
    "canonicalization": { "const": "fkst-testing-runner-invocation-canonical-json.v1" },
    "invocation_id": { "$ref": "./testing-package-executor.request.v1.schema.json#/$defs/identityString" },
    "qa_run_ref": { "$ref": "./testing-package-executor.request.v1.schema.json#/$defs/identityString" },
    "attempt_ref": { "$ref": "./testing-package-executor.request.v1.schema.json#/$defs/identityString" },
    "executor": { "$ref": "#/$defs/invocationExecutorIdentity" },
    "resolved_executor": { "$ref": "#/$defs/resolvedExecutor" },
    "execution_profile": { "$ref": "./testing-package-executor.request.v1.schema.json#/$defs/identityString" },
    "approved_input_refs": { "$ref": "#/$defs/approvedInputRefs" },
    "requested_capabilities": { "type": "array", "items": { "$ref": "./testing-package-executor.request.v1.schema.json#/$defs/identityString" }, "minItems": 1, "maxItems": 64, "uniqueItems": true },
    "budgets": { "$ref": "#/$defs/executionBudgets" },
    "deadline_epoch_seconds": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "producer": { "$ref": "#/$defs/producerIdentity" },
    "trace_id": { "$ref": "./testing-package-executor.request.v1.schema.json#/$defs/identityString" },
    "dedup_key": { "$ref": "./testing-package-executor.request.v1.schema.json#/$defs/identityString" },
    "canonical_request_sha256": { "$ref": "./testing-package-executor.request.v1.schema.json#/$defs/sha256" }
  },
  "$defs": {
    "invocationExecutorIdentity": {
      "allOf": [
        { "$ref": "./testing-package-executor.request.v1.schema.json#/$defs/executorIdentity" },
        { "properties": { "contract_major": { "const": "testing-runner.v1" } } }
      ]
    },
    "resolvedExecutor": {
      "type": "object", "additionalProperties": false,
      "required": ["executor_id", "version", "capability_digest"],
      "properties": {
        "executor_id": { "$ref": "./testing-package-executor.request.v1.schema.json#/$defs/identityString" },
        "version": { "$ref": "./testing-package-executor.request.v1.schema.json#/$defs/semanticVersion" },
        "capability_digest": { "$ref": "./testing-package-executor.request.v1.schema.json#/$defs/sha256" }
      }
    },
    "approvedInputRefs": {
      "type": "object", "additionalProperties": false,
      "required": ["source_ref", "pql_input_set_ref", "approved_test_case_set_ref", "structured_plan_ref", "package_release_ref", "package_manifest_ref", "schema_catalog_ref", "capability_port_set_ref", "policy_ref"],
      "properties": {
        "source_ref": { "allOf": [{ "$ref": "./testing-package-executor.request.v1.schema.json#/$defs/reference" }, { "properties": { "kind": { "const": "testing-package-source" } } }] },
        "pql_input_set_ref": { "allOf": [{ "$ref": "./testing-package-executor.request.v1.schema.json#/$defs/reference" }, { "properties": { "kind": { "const": "testing-package-pql-input" } } }] },
        "approved_test_case_set_ref": { "allOf": [{ "$ref": "./testing-package-executor.request.v1.schema.json#/$defs/reference" }, { "properties": { "kind": { "const": "testing-approved-test-case-set" } } }] },
        "structured_plan_ref": { "allOf": [{ "$ref": "./testing-package-executor.request.v1.schema.json#/$defs/reference" }, { "properties": { "kind": { "const": "testing-structured-plan" } } }] },
        "package_release_ref": { "allOf": [{ "$ref": "./testing-package-executor.request.v1.schema.json#/$defs/reference" }, { "properties": { "kind": { "const": "testing-package-release" } } }] },
        "package_manifest_ref": { "allOf": [{ "$ref": "./testing-package-executor.request.v1.schema.json#/$defs/reference" }, { "properties": { "kind": { "const": "testing-package-manifest" } } }] },
        "schema_catalog_ref": { "allOf": [{ "$ref": "./testing-package-executor.request.v1.schema.json#/$defs/reference" }, { "properties": { "kind": { "const": "testing-schema-catalog" } } }] },
        "capability_port_set_ref": { "allOf": [{ "$ref": "./testing-package-executor.request.v1.schema.json#/$defs/reference" }, { "properties": { "kind": { "const": "testing-package-capability-set" } } }] },
        "policy_ref": { "allOf": [{ "$ref": "./testing-package-executor.request.v1.schema.json#/$defs/reference" }, { "properties": { "kind": { "const": "testing-package-policy" } } }] }
      }
    },
    "executionBudgets": {
      "type": "object", "additionalProperties": false,
      "required": ["step_budget", "time_budget_seconds"],
      "properties": {
        "step_budget": { "type": "integer", "minimum": 1, "maximum": 8 },
        "time_budget_seconds": { "type": "integer", "minimum": 1, "maximum": 600 }
      }
    },
    "producerIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "$ref": "./testing-package-executor.request.v1.schema.json#/$defs/identityString" },
        "version": { "$ref": "./testing-package-executor.request.v1.schema.json#/$defs/semanticVersion" }
      }
    }
  }
}
